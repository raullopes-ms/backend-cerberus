# Copie para .env e preencha. O .env real nunca é versionado.

# dev | production | test
# Em produção o CORS passa a aceitar SOMENTE o que estiver em CORS_ORIGINS.
# Fora de produção, origens locais (localhost, 127.0.0.1, rede privada) são
# liberadas automaticamente para facilitar o desenvolvimento.
NODE_ENV=dev

# Porta HTTP da API.
PORT=3000

# Postgres. Em produção use SSL: ?sslmode=verify-full
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO

# Segredo de assinatura dos tokens JWT — mínimo de 32 caracteres.
# Gere um novo com: openssl rand -base64 32
JWT_SECRET=SEGREDO_JWT_AQUI

# Domínios do front-end autorizados a chamar a API pelo navegador, separados
# por vírgula. OBRIGATÓRIO quando NODE_ENV=production.
# Ex.: https://cerberus.suaempresa.com.br,https://www.cerberus.suaempresa.com.br
CORS_ORIGINS=http://localhost:5173

# Administrador inicial criado por `npm run seed`.
ADMIN_EMAIL=ADMIN_EMAIL_AQUI
ADMIN_PASSWORD=SENHA_TEMPORARIA_SEGURA
ADMIN_NOME=Administrador
